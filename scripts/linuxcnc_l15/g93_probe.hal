# L1.5 采集配置: sampler 10 通道挂 servo-thread (1kHz)
# 列序 (halsampler -t 输出: 第0列=sample 序号, 之后按本序):
#   1 joint.0.motor-pos-cmd   2 joint.1   3 joint.2
#   4 motion.current-vel      5 motion.requested-vel   6 motion.feed-upm
#   7 motion.distance-to-go   8 motion.motion-type(s32) 9 motion.program-line(s32)
#  10 halui.feed-override.value
# 注: motion.feed-hold 为 IN 引脚不可 net 进 sampler (IN→IN),
#     P6 由 feed_upm==0 特征窗口 + 运行时刻表联合判定 (M_PRED P6 口径)
loadrt sampler cfg=fffffffssf depth=16384
addf sampler.0 servo-thread

net l15:j0 joint.0.motor-pos-cmd   => sampler.0.pin.0
net l15:j1 joint.1.motor-pos-cmd   => sampler.0.pin.1
net l15:j2 joint.2.motor-pos-cmd   => sampler.0.pin.2
net l15:cv  motion.current-vel     => sampler.0.pin.3
net l15:rv  motion.requested-vel   => sampler.0.pin.4
net l15:fu  motion.feed-upm        => sampler.0.pin.5
net l15:dtg motion.distance-to-go  => sampler.0.pin.6
net l15:mt  motion.motion-type     => sampler.0.pin.7
net l15:pl  motion.program-line    => sampler.0.pin.8
net l15:ovr halui.feed-override.value => sampler.0.pin.9

# FIFO 16384 ≈ 16s @1kHz;溢出检查: halcmd show param sampler.0.overruns
# 导出 (程序结束后第二终端): halsampler -t sampler.0 > capture_rN.csv
